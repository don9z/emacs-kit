;;; early-init.el --- Early Emacs Kit compatibility settings -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

(defvar emacs-kit-macos-native-comp-workaround t
  "Whether to work around the known macOS 27/libgccjit 14.3.0 target bug.
Set this to nil before loading the kit to opt out.")

(defun emacs-kit--macos-major-version ()
  "Return the macOS major version, or nil if it cannot be determined."
  (when (eq system-type 'darwin)
    (condition-case nil
        (with-temp-buffer
          (when (eq 0 (call-process "/usr/bin/sw_vers" nil t nil
                                   "-productVersion"))
            (truncate (string-to-number (buffer-string)))))
      (file-error nil))))

(defun emacs-kit--deployment-target-configured-p ()
  "Return non-nil when the user already selected a deployment target."
  (or (let ((target (getenv "MACOSX_DEPLOYMENT_TARGET")))
        (and target (not (equal target ""))))
      (catch 'configured
        (dolist (option (append native-comp-driver-options
                                native-comp-compiler-options))
          (when (and (stringp option)
                     (string-match-p
                      "\\`-mmacosx-version-min\\(?:=\\|\\'\\)" option))
            (throw 'configured t))))))

(defun emacs-kit-configure-native-comp ()
  "Apply the deployment-target workaround only to the reported combination.
Keep native compilation enabled and preserve explicit user target settings."
  (when (and emacs-kit-macos-native-comp-workaround
             (eq system-type 'darwin)
             (fboundp 'native-comp-available-p)
             (native-comp-available-p))
    (require 'comp)
    (when (and (fboundp 'comp-libgccjit-version)
               (equal (comp-libgccjit-version) '(14 3 0))
               (equal (emacs-kit--macos-major-version) 27)
               (not (emacs-kit--deployment-target-configured-p)))
      ;; The bundled driver incorrectly infers 18.0 on this OS/compiler pair.
      ;; Set the actual OS major version for this machine's native Lisp code.
      (add-to-list 'native-comp-driver-options "-mmacosx-version-min=27.0")
      t)))

(emacs-kit-configure-native-comp)

(defvar emacs-kit-early-init-source (file-truename load-file-name)
  "Shared startup file for the current checkout.")

(defun emacs-kit-install-early-init ()
  "Explicitly install a loader to run the kit before package activation.
Never overwrite an existing user file or symlink.  Return a status symbol.
This command is not called automatically by the kit."
  (interactive)
  (if (version< emacs-version "27.1")
      (progn (message "This Emacs version does not use early-init.el")
             'unsupported)
    (let* ((target (if (bound-and-true-p early-init-file)
                       early-init-file
                     (expand-file-name "early-init.el" user-emacs-directory)))
           (entry (format
                   (concat ";;; early-init.el --- Emacs Kit entry -*- lexical-binding: t; -*-\n"
                           ";; Generated by emacs-kit; settings remain in the checkout.\n"
                           "(load %S nil t)\n")
                   emacs-kit-early-init-source)))
      (cond
       ((or (file-exists-p target) (file-symlink-p target))
        (if (or (file-equal-p target emacs-kit-early-init-source)
                (and (file-regular-p target)
                     (with-temp-buffer
                       (insert-file-contents target)
                       (equal (buffer-string) entry))))
            (progn (message "Emacs Kit early startup is already connected")
                   'already-configured)
          (user-error "Existing early init left unchanged; see Emacs Kit README")))
       (t
        (make-directory (file-name-directory target) t)
        ;; Exclusive creation also protects a file created concurrently.
        (write-region entry nil target nil 'silent nil 'excl)
        (message "Emacs Kit early startup installed; restart Emacs to use it")
        'installed)))))

(provide 'emacs-kit-early-init)
;;; early-init.el ends here
